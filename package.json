{
  "name": "kanau-songlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "build": "node build.mjs",
    "build:main": "node build.mjs main",
    "build:admin": "node build.mjs admin",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "playwright test",
    "e2e:build": "npm run build && playwright test",
    "refactor:symbols": "node scripts/refactor/symbol-baseline.mjs",
    "refactor:build-compare": "node scripts/refactor/build-compare.mjs",
    "arch": "node scripts/arch-lint.mjs",
    "db:status": "node scripts/db-migrate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs --apply",
    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "acorn": "^8.17.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "fuse.js": "7.0.0"
  }
}
