CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=replace_with_staging_d1_database_id
CLOUDFLARE_API_TOKEN=replace_with_staging_cloudflare_api_token

# Optional. Keep the server bound locally and expose it with Tailscale Serve.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8789

# Optional defense in depth for the browser UI/API.
ADMIN_TOKEN=replace_with_staging_admin_password

# Optional. Paste the staging key/genre spreadsheet tab URL here
# if you want the admin UI to sync without entering the URL each time.
KEY_REFERENCE_CSV_URL=
